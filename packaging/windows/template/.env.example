# ---------------------------------------------------------------------------
# تنظیمات «یوتیوب دانلودر» (این فایل را با نام .env کپی کنید و مقادیر را تغییر دهید)
# هر خط باید به شکل KEY=VALUE باشد؛ خطوط شروع‌شده با # نادیده گرفته می‌شوند.
# ---------------------------------------------------------------------------

# پورت سرویس (پیش‌فرض ۳۰۰۰). اگر اشغال باشد، خودکار پورت بعدی انتخاب می‌شود.
PORT=3000

# --- تاریخچه (اختیاری) ---
# بدون دیتابیس هم برنامه کار می‌کند؛ فقط تاریخچه‌ی دانلودها ذخیره نمی‌شود.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- پوشه‌ها (پیش‌فرض: پوشه‌ی data کنار همین فایل) ---
# DOWNLOAD_DIR=D:\YouTubeDownloads
# YTDLP_CACHE_DIR=D:\YouTubeDownloads\cache

# --- عبور از محدودیت‌های یوتیوب ---
# اگر خطای «Sign in to confirm you're not a bot» دیدید، فایل کوکی مرورگر (فرمت Netscape) را بدهید:
# YTDLP_COOKIES_FILE=D:\cookies.txt
# یا از پراکسی استفاده کنید:
# YTDLP_PROXY=socks5://127.0.0.1:1080
# YTDLP_EXTRA_ARGS=--force-ipv4

# --- رفتار دانلود ---
# مدت نگهداری فایل‌ها روی سرور به دقیقه (پیش‌فرض ۱۲۰)
# FILE_TTL_MINUTES=120
# حداکثر دانلود هم‌زمان (بقیه در صف می‌مانند)
# MAX_CONCURRENT_DOWNLOADS=3
# سقف درخواست هر کاربر در دقیقه (۰ = بدون محدودیت)
# RATE_LIMIT_PER_MINUTE=30

# --- حالت نمایشی (برای دمو بدون اینترنت/یوتیوب) ---
# DEMO_MODE=1
