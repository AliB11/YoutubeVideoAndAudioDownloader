# اتصال به PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- اختیاری ---
# مسیر باینری yt-dlp (در صورت خالی بودن، به‌صورت خودکار از GitHub دانلود می‌شود)
# YTDLP_PATH=/usr/local/bin/yt-dlp

# مسیر ffmpeg (در صورت خالی بودن از پکیج ffmpeg-static استفاده می‌شود)
# FFMPEG_PATH=/usr/bin/ffmpeg

# اگر یوتیوب روی سرور شما خطای "Sign in to confirm you're not a bot" داد،
# فایل کوکی (فرمت Netscape) را از مرورگر خود export کرده و مسیرش را اینجا بدهید
# YTDLP_COOKIES_FILE=/app/cookies.txt

# پراکسی برای yt-dlp (در صورت نیاز)
# YTDLP_PROXY=socks5://127.0.0.1:1080

# آرگومان‌های اضافی yt-dlp
# YTDLP_EXTRA_ARGS=--force-ipv4

# مدت نگهداری فایل‌های دانلودشده روی سرور به دقیقه (پیش‌فرض 120)
# FILE_TTL_MINUTES=120
