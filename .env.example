# اتصال به PostgreSQL (اختیاری — در صورت نبود، تاریخچه ذخیره نمی‌شود ولی دانلود کار می‌کند)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- باینری‌ها ---
# مسیر باینری yt-dlp (در صورت خالی بودن: .bin/ پروژه → PATH → دانلود خودکار از GitHub)
# YTDLP_PATH=/usr/local/bin/yt-dlp
# مسیر ffmpeg (در صورت خالی بودن از پکیج ffmpeg-static استفاده می‌شود)
# FFMPEG_PATH=/usr/bin/ffmpeg
# پوشه‌ی کش yt-dlp (پیش‌فرض: /tmp/yt-dlp-cache)
# YTDLP_CACHE_DIR=/tmp/yt-dlp-cache

# --- عبور از محدودیت‌های یوتیوب ---
# اگر یوتیوب خطای «Sign in to confirm you're not a bot» داد، فایل کوکی (فرمت Netscape) را بدهید
# YTDLP_COOKIES_FILE=/app/cookies.txt
# پراکسی برای yt-dlp
# YTDLP_PROXY=socks5://127.0.0.1:1080
# آرگومان‌های اضافی yt-dlp
# YTDLP_EXTRA_ARGS=--force-ipv4
# دریافت ماژول حل چالش JS از راه دور (پیش‌فرض: برای باینری‌های رسمی لازم نیست و
# برای باینری‌های pip به‌صورت خودکار ejs:github تنظیم می‌شود)
# YTDLP_REMOTE_COMPONENTS=ejs:github

# --- رفتار دانلود و نگهداری فایل ---
# پوشه‌ی فایل‌های دانلودشده (پیش‌فرض: /tmp/yt-downloader-jobs)
# DOWNLOAD_DIR=/tmp/yt-downloader-jobs
# مدت نگهداری فایل‌های دانلودشده روی سرور به دقیقه (پیش‌فرض ۱۲۰)
# FILE_TTL_MINUTES=120
# حداکثر دانلود هم‌زمان؛ بقیه در صف می‌مانند (پیش‌فرض ۳)
# MAX_CONCURRENT_DOWNLOADS=3
# سقف درخواست هر IP در دقیقه برای اندپوینت‌های info/jobs (۰ = بدون محدودیت)
# RATE_LIMIT_PER_MINUTE=30
# مدت اعتبار کش اطلاعات ویدئو (میلی‌ثانیه، پیش‌فرض ۵ دقیقه)
# INFO_CACHE_TTL_MS=300000
# حداکثر زمان استخراج اطلاعات ویدئو (میلی‌ثانیه، پیش‌فرض ۱۲۰۰۰۰)
# YTDLP_INFO_TIMEOUT_MS=120000
# حداکثر اتصال‌های دیتابیس (پیش‌فرض ۵)
# DB_POOL_MAX=5

# --- حالت نمایشی (برای محیط‌هایی که به یوتیوب دسترسی ندارند) ---
# با ۱ شدن، اطلاعات ویدئو از داده‌ی نمونه خوانده می‌شود و دانلود از یک کلیپ محلی انجام می‌شود
# DEMO_MODE=1
# آدرس پایه‌ای که yt-dlp برای دانلود کلیپ نمونه استفاده می‌کند (پیش‌فرض: http://127.0.0.1:PORT)
# DEMO_MEDIA_BASE_URL=http://127.0.0.1:3000

# آدرس عمومی سایت (برای متادیتا، robots و sitemap)
# NEXT_PUBLIC_SITE_URL=https://example.com
